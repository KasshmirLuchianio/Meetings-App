{
  "expo": {
    "name": "Meetings.ro",
    "slug": "meetings-ro",
    "version": "1.0.0",
    "scheme": "meetingsro",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF8F3"
    },
    "ios": {
      "bundleIdentifier": "ro.meetings.app",
      "buildNumber": "1",
      "minimumOsVersion": "13.0",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Meetings.ro necesită acces la microfon pentru înregistrarea ședințelor.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeAudioData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          }
        ]
      }
    },
    "android": {
      "package": "ro.meetings.app",
      "versionCode": 1,
      "targetSdkVersion": 34,
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B2A4A"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Meetings.ro necesită acces la microfon pentru înregistrarea ședințelor."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
