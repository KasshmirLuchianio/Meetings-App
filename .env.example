# ============================================================
# Meetings Platform — Environment Configuration
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# ============================================================


# ── REQUIRED ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_a_secure_random_string_here

# MongoDB credentials
MONGO_USER=admin
MONGO_PASS=CHANGE_ME_strong_password_here
DB_NAME=meetings_platform


# ── INSTITUTION BRANDING ──────────────────────────────────────
INSTITUTION_NAME=Primăria Orașului Exemplu
APP_BASE_URL=https://meetings.institutia-mea.ro

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://meetings.institutia-mea.ro,http://localhost:3000


# ── LOCAL AI — WHISPER (Speech-to-Text) ──────────────────────
# Model sizes: tiny | base | small | medium | large-v3
# Larger = more accurate but slower and requires more RAM
# Recommendation:
#   4GB RAM  → tiny or base
#   8GB RAM  → small or medium
#   16GB RAM → large-v3
WHISPER_MODEL_SIZE=medium

# Device: cpu | cuda (requires NVIDIA GPU + CUDA drivers)
WHISPER_DEVICE=cpu

# Compute type: int8 (CPU) | float16 (GPU)
WHISPER_COMPUTE_TYPE=int8


# ── LOCAL AI — OLLAMA (LLM) ───────────────────────────────────
# Model options:
#   llama3:8b-instruct    → 5GB RAM, fast, decent Romanian
#   llama3:70b-instruct   → 40GB RAM, best quality
#   mistral:7b-instruct   → 4GB RAM, alternative
OLLAMA_MODEL=llama3:8b-instruct


# ── SMTP (Email) ──────────────────────────────────────────────
# For development: leave defaults (uses Mailhog at localhost:8025)
# For production: configure institution's mail server
SMTP_HOST=smtp
SMTP_PORT=1025
SMTP_FROM=no-reply@institutia-mea.ro
# SMTP_USER=user@institutia-mea.ro
# SMTP_PASS=smtp_password
# SMTP_TLS=true


# ── UPLOAD LIMITS ─────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100


# ── ACCESS CONTROL ────────────────────────────────────────────
# false = only admins can create users (recommended for institutions)
# true  = anyone can register (SaaS mode)
ALLOW_SELF_REGISTER=false

# License limits (-1 = unlimited)
LICENSE_MAX_USERS=-1
LICENSE_MAX_MEETINGS_PER_MONTH=-1


# ── OPTIONAL: AI FALLBACK ─────────────────────────────────────
# Only needed if Ollama is unavailable (e.g. during initial setup)
# Remove in production air-gapped deployments
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...


# ── OPTIONAL: DIGITAL SIGNATURES ─────────────────────────────
# Path to PKCS#12 certificate for signing PDF documents
# SIGNING_CERT_PATH=/etc/meetings/signing.p12
# SIGNING_CERT_PASS=certificate_password
